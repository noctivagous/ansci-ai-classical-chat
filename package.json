{
  "description": "AnSci \u2014 a classical-AI system whose mind is an ontology graph of ontological priors (yin/yang, Wuxing, trigrams), not a neural network.",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "name": "ansci-ai-classical-chat",
  "private": true,
  "scripts": {
    "ask": "npm run build --silent && node dist/src/cli.js",
    "chat": "npm run build --silent && node scripts/ansci-chat.mjs",
    "chat:cskg": "npm run build --silent && node dist/src/chat.js",
    "chat:once": "npm run build --silent && node scripts/chat-once.mjs",
    "build": "tsc",
    "dev": "npm run build --silent && node dist/src/cskg/devserver.js",
    "ansci:chat": "npm run build --silent && node scripts/ansci-chat.mjs",
    "chat:ansci": "npm run build --silent && node scripts/ansci-chat.mjs",
    "ansci:density": "npm run build --silent && node scripts/ansci-density.mjs",
    "ansci:holdout": "npm run build --silent && node scripts/ansci-holdout.mjs",
    "ansci:transcript": "npm run build --silent && node scripts/ansci-transcript.mjs",
    "loop:tree": "node scripts/devloop-tree.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:t0": "npm run build --silent && node scripts/test-tier.mjs t0",
    "test:core": "npm run build --silent && node scripts/test-tier.mjs core",
    "test:bank": "npm run build --silent && node scripts/test-tier.mjs bank",
    "test:units": "npm run build --silent && node scripts/test-tier.mjs units",
    "test:programmes": "npm run build --silent && node scripts/test-tier.mjs programmes",
    "typecheck": "tsc --noEmit",
    "ai:check": "node ai-system/check-map.mjs && node ai-system/check-page.mjs",
    "ansci:demo": "npm run build --silent && node demo/wuxing-parser/run.mjs",
    "ansci:depth-baseline": "npm run build --silent && node scripts/ansci-depth-baseline.mjs",
    "ansci:valency": "npm run build --silent && node scripts/ansci-valency-challenge.mjs",
    "ansci:aspect": "npm run build --silent && node scripts/ansci-aspect-challenge.mjs",
    "ansci:construction": "npm run build --silent && node scripts/ansci-construction-challenge.mjs",
    "ansci:construction-family": "npm run build --silent && node scripts/ansci-construction-family.mjs",
    "ansci:sense": "npm run build --silent && node scripts/ansci-sense-challenge.mjs",
    "ansci:anchor-audit": "npm run build --silent && node scripts/ansci-anchor-audit.mjs",
    "ansci:ingest": "npm run build --silent && node scripts/ansci-ingest-suwen5.mjs",
    "ansci:build-cskg-bundle": "npm run build --silent && node scripts/build-cskg-bundle.mjs",
    "ansci:prior-trial": "npm run build --silent && node scripts/ansci-prior-trial.mjs",
    "ansci:dashboard": "npm --prefix demo/dashboard run build",
    "ansci:stage5-probes": "node scripts/ansci-stage5-probes.mjs",
    "ansci:stage5": "node scripts/ansci-stage5.mjs",
    "ansci:sealed": "npm run build --silent && node scripts/ansci-sealed.mjs",
    "ansci:triage": "npm run build --silent && node scripts/ansci-triage.mjs"
  },
  "type": "commonjs",
  "version": "0.1.0"
}
