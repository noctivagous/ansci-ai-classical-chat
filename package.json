{
  "description": "AnSci \u2014 a classical-AI system whose mind is an ontology graph of ontological priors (yin/yang, Wuxing, trigrams), not a neural network.",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "name": "ansci-ai-classical-chat",
  "private": true,
  "scripts": {
    "ask": "npm run build --silent && node dist/src/cli.js",
    "chat": "npm run build --silent && node dist/src/chat.js",
    "chat:once": "npm run build --silent && node scripts/chat-once.mjs",
    "build": "tsc",
    "dev": "npm run build --silent && node dist/src/cskg/devserver.js",
    "fork:chat": "npm run build --silent && node scripts/fork-chat.mjs",
    "chat:fork": "npm run build --silent && node scripts/fork-chat.mjs",
    "fork:density": "npm run build --silent && node scripts/fork-density.mjs",
    "fork:holdout": "npm run build --silent && node scripts/fork-holdout.mjs",
    "fork:transcript": "npm run build --silent && node scripts/fork-transcript.mjs",
    "loop:tree": "node scripts/devloop-tree.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "fork:demo": "npm run build --silent && node demo/wuxing-parser/run.mjs",
    "fork:depth-baseline": "npm run build --silent && node scripts/fork-depth-baseline.mjs",
    "fork:valency": "npm run build --silent && node scripts/fork-valency-challenge.mjs",
    "fork:aspect": "npm run build --silent && node scripts/fork-aspect-challenge.mjs",
    "fork:construction": "npm run build --silent && node scripts/fork-construction-challenge.mjs",
    "fork:sense": "npm run build --silent && node scripts/fork-sense-challenge.mjs",
    "fork:dashboard": "npm --prefix demo/dashboard run build",
    "fork:stage5-probes": "node scripts/fork-stage5-probes.mjs",
    "fork:stage5": "node scripts/fork-stage5.mjs"
  },
  "type": "commonjs",
  "version": "0.1.0"
}
